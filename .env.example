# Changelog API endpoint (GraphQL). Optional; defaults to the production endpoint.
# Point this at a dev/preview deployment of the changelog app to test against it.
# Used by the changelog page and, under `pnpm dev`, by the Vite proxy in .vitepress/config.mts.
VITE_CHANGELOG_ENDPOINT=https://changelog-i0d011qixh.erp.dev/query
